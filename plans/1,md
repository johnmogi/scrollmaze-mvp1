Insert the helper utilities below somewhere after the data catalogs (for example right after const bossRoster = [...]) and before any render/handler functions. They reuse existing structures and keep the emoji-rich theme intact.

javascript
function getCatalogEntry(catalog, rarityKey) {
  const upperBound = rarityOrder.indexOf(rarityKey);
  const allowed = catalog.filter((entry) => rarityOrder.indexOf(entry.rarity) <= upperBound);
  const pool = allowed.length ? allowed : catalog;
  return randomFrom(pool);
}

function generateItem(rarityKey) {
  const data = getCatalogEntry(itemCatalog, rarityKey);
  return { ...data, rarity: rarityKey };
}

function generateTrap(rarityKey) {
  const data = getCatalogEntry(trapCatalog, rarityKey);
  return { ...data, rarity: rarityKey };
}

function generateStory() {
  const story = randomFrom(storyPrompts);
  const mood = randomFrom([
    "It was chronicled in syrup-stained ink.",
    "The scroll murmured the tale in past tense.",
    "Echoes of crumbs carried the saga onward.",
  ]);
  return { ...story, mood };
}

function generateBoss() {
  const rarity = weightedRandom(bossRarityWeights);
  const options = bossRoster.filter((boss) => boss.rarity === rarity);
  return randomFrom(options.length ? options : bossRoster);
}

function generateRecovery(rarityKey) {
  const data = getCatalogEntry(recoveryDeck, rarityKey);
  return { ...data, rarity: rarityKey };
}

function generateRiddle(rarityKey) {
  const data = getCatalogEntry(riddleDeck, rarityKey);
  return { ...data, rarity: rarityKey };
}

function generateRelic(rarityKey) {
  const data = getCatalogEntry(relicCatalog, rarityKey);
  return { ...data, rarity: rarityKey };
}

function generateBoard() {
  const grid = [];
  for (let r = 0; r < boardConfig.rows; r += 1) {
    const row = [];
    for (let c = 0; c < boardConfig.cols; c += 1) {
      const roomType = weightedRandom(
        Object.entries(roomTypeWeights).map(([key, weight]) => ({ key, weight }))
      );
      const rarity = weightedRandom(boardRarityWeights);
      row.push({ roomType, rarity, ...buildTile(roomType, rarity) });
    }
    grid.push(row);
  }
  return { rows: boardConfig.rows, cols: boardConfig.cols, cells: grid };
}

function buildTile(roomType, rarity) {
  switch (roomType) {
    case "monster": {
      const familyIndex = Math.floor(Math.random() * monsterFamilies.length);
      const monster = generateMonster(familyIndex);
      return { label: monster.name, details: monster };
    }
    case "trap": {
      const trap = generateTrap(rarity);
      return { label: trap.name, details: trap };
    }
    case "item": {
      const item = generateItem(rarity);
      return { label: item.name, details: item };
    }
    case "story": {
      const story = generateStory();
      return { label: story.title, details: story };
    }
    case "recoveryarea": {
      const recovery = generateRecovery(rarity);
      return { label: recovery.name, details: recovery };
    }
    case "riddle": {
      const riddle = generateRiddle(rarity);
      return { label: riddle.prompt, details: riddle };
    }
    case "relic": {
      const relic = generateRelic(rarity);
      return { label: relic.name, details: relic };
    }
    default:
      return { label: "Empty Hall", details: {} };
  }
}
